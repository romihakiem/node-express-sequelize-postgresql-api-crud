# Server
PORT=3000
NODE_ENV=development

# Database
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=test_node_api
PG_USER=postgres
PG_PASSWORD=
# Set PG_SSL=true kalau connect ke managed Postgres (RDS/Supabase/dst) yang mewajibkan SSL
PG_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
